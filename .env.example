NODE_ENV=development

# Server
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=velie_app
DB_PASS=change-me
DB_NAME=velie_db

# Self-hosted WSAPI (WhatsApp service, pairing-code mode)
WSAPI_BASE_URL=http://127.0.0.1:3001
WSAPI_ADMIN_KEY=change-me-wsapi-admin-key

# Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=8

# Dispatch worker
DISPATCH_INTERVAL_CRON=* * * * *
DISPATCH_MIN_DELAY_MS=30000
DISPATCH_MAX_DELAY_MS=60000

# Public base URL used to build absolute image URLs sent to WSAPI
PUBLIC_BASE_URL=http://localhost:4000

# Shared secret used by /webhook/wsapi (X-WSAPI-Signature header)
WEBHOOK_SECRET=change-me-webhook-secret